<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>mower_status</name>
  <version>1.0.0</version>
  <description>
    Определение статуса робота-газонокосилки (ROTATED / MOVEMENT_ON_PLACE /
    ROBOT DRIVING) по IMU и GPS, плюс фильтрация зашумлённого GPS
    фильтром Калмана.
  </description>
  <maintainer email="vovagefling08684@gmail.com">Vladimir</maintainer>
  <license>MIT</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
